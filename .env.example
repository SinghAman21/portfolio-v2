# Public application URL
# Used for Dodo Payments success and cancellation redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=

# Dodo Payments
# Use test_mode while developing and live_mode in production.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=

# Dodo product ID for the yourbid-lol product.
# The product must be configured as a one-time USD 10.00 product in Dodo.
DODO_YOURBID_PRODUCT_ID=

# Optional: webhook signing key from the Dodo dashboard.
# Required only when webhook handling is enabled.
DODO_PAYMENTS_WEBHOOK_KEY=
